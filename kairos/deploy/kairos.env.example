# /etc/kairos-v11/kairos.env  (root:kairosv11 0640). NEVER commit real values.
KAIROS_MODE=paper
KAIROS_DATA_DIR=/var/lib/kairos-v11
KAIROS_DATABASE_URL=postgresql+psycopg://kairosv11@/kairos_v11?host=/var/run/postgresql
KAIROS_PUBLIC_ORIGIN=https://usekairos.net
KAIROS_MAX_USERS=3
KAIROS_MASTER_KEY_FILE=/var/lib/kairos-v11/secrets/master.key
KAIROS_REGISTRY_KEY=
# Optional market-data key (read usage) enabling Kalshi WebSocket order books; without it REST polling is used.
# Paths only — the key file itself is 0600 and owned by kairosv11.
KAIROS_KALSHI_KEY_ID=
KAIROS_KALSHI_KEY_FILE=/var/lib/kairos-v11/secrets/kalshi_md.pem
# Optional (research only, default off, $10/month hard cap in config): leave empty.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

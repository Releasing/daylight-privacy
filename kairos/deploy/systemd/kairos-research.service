[Unit]
Description=Kairos shadow-learning job (low priority, no exchange keys)
After=postgresql.service

[Service]
Type=oneshot
User=kairosv11
Group=kairosv11
EnvironmentFile=/etc/kairos-v11/kairos.env
# research never receives Kalshi credentials
Environment=KAIROS_KALSHI_KEY_ID= KAIROS_KALSHI_KEY_FILE=
WorkingDirectory=/opt/kairos-v11/current
ExecStart=/opt/kairos-v11/current/.venv/bin/kairos research
Nice=15
IOSchedulingClass=idle
CPUQuota=60%
CPUWeight=20
MemoryMax=1200M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kairos-v11
InaccessiblePaths=/var/lib/kairos-v11/secrets
TimeoutStartSec=3600

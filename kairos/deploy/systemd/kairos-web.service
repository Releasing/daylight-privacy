[Unit]
Description=Kairos V11.2 engine + API (paper by default)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kairosv11
Group=kairosv11
EnvironmentFile=/etc/kairos-v11/kairos.env
WorkingDirectory=/opt/kairos-v11/current
ExecStart=/opt/kairos-v11/current/.venv/bin/kairos serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
Nice=-5
CPUWeight=900
MemoryHigh=2200M
MemoryMax=2600M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kairos-v11
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
